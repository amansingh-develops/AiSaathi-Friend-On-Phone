<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <!-- Solid fill as base (ensures visibility) -->
    <solid android:color="#E04040" />
    <!-- Gradient overlay -->
    <gradient
        android:type="radial"
        android:startColor="#FF416C"
        android:endColor="#FF4B2B"
        android:gradientRadius="50%p"
        android:centerX="0.5"
        android:centerY="0.5" />
</shape>
